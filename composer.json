{
    "name": "sendkuy/sdk",
    "description": "PHP SDK for the SendKuy API: send WhatsApp, SMS and email from your own code.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sendkuy", "whatsapp", "whatsapp-api", "sms", "email", "otp", "notifications", "messaging", "indonesia"],
    "homepage": "https://docs.sendkuy.com",
    "support": {
        "issues": "https://github.com/sendkuy/sendkuy-php/issues",
        "source": "https://github.com/sendkuy/sendkuy-php",
        "docs": "https://docs.sendkuy.com"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8.2|^8.0",
        "guzzlehttp/psr7": "^2.9|^3.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "SendKuy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SendKuy\\Tests\\": "tests/",
            "SendKuy\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "pint",
        "generate": "php bin/generate-objects"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
